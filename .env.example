# Copy this file to .env and fill in real values before running.

# Required — used to sign admin/team JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=1234

# Local dev seed admin account (Section 4). Change this before the live event.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=11

PORT=4000
CORS_ORIGIN=http://localhost:5173
DB_PATH=./brainhunt.db
